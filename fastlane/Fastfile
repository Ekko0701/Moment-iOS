# Moment iOS 자동화 lane 모음.
# 실행: bundle exec fastlane <lane>   예) bundle exec fastlane test

# fastlane 사용 통계를 보내지 않는다
opt_out_usage
# lane 목록 문서(fastlane/README.md)를 실행할 때마다 다시 만들지 않는다
skip_docs

default_platform(:ios)

WORKSPACE = "Moment.xcworkspace"
# 모든 모듈의 테스트 타깃을 묶은 워크스페이스 스킴 (Workspace.swift에서 정의)
TEST_SCHEME = "Moment-AllTests"
# 테스트를 돌릴 시뮬레이터. 개발 Mac과 GitHub 러너에 모두 있는 기기여야 한다
TEST_DEVICE = "iPhone 17"

platform :ios do
  before_all do
    # 저장소 루트의 .xcode-version과 선택된 Xcode가 다르면 여기서 멈춘다
    expected = File.read("../.xcode-version").strip
    selected = sh("xcodebuild", "-version", log: false)[/Xcode (\S+)/, 1]
    unless selected == expected
      UI.user_error!("Xcode #{expected}이 필요한데 지금 선택된 것은 #{selected}입니다. xcode-select로 바꿔 주세요.")
    end
  end

  desc "Tuist로 의존성을 받고 Xcode 워크스페이스를 만든다"
  lane :generate do
    # fastlane은 fastlane/ 폴더에서 명령을 실행하므로 저장소 루트로 올라가서 실행한다
    Dir.chdir("..") do
      sh("tuist", "install")
      sh("tuist", "generate", "--no-open")
    end
  end

  desc "모든 모듈의 테스트를 시뮬레이터에서 실행한다"
  lane :test do
    generate
    run_tests(
      workspace: WORKSPACE,
      scheme: TEST_SCHEME,
      # 같은 이름의 시뮬레이터가 여러 iOS 버전에 있으면 가장 높은 버전을 쓴다
      device: TEST_DEVICE,
      # 명령줄 빌드는 Swift 매크로와 패키지 플러그인을 승인할 화면이 없으므로 검증을 건너뛴다
      xcargs: "-skipMacroValidation -skipPackagePluginValidation",
      xcodebuild_formatter: "xcbeautify",
      # CI에서는 Swift 패키지를 저장소 안에 받아 캐시할 수 있게 한다
      cloned_source_packages_path: is_ci ? ".build/SourcePackages" : nil,
      # 실패 원인을 Xcode에서 열어 볼 수 있도록 결과 묶음(.xcresult)을 남긴다
      result_bundle: true,
      output_types: "junit",
      output_directory: "fastlane/test_output",
      buildlog_path: "fastlane/logs"
    )
  end
end
